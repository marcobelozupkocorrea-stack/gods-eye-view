{
  "id": "/?origem=app",
  "name": "ABC World View",
  "short_name": "ABC World View",
  "description": "Mapa de monitoramento em tempo real: alertas do Brasil, voos, navios, câmeras e clima.",
  "lang": "pt-BR",
  "start_url": "/?origem=app",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#05090f",
  "theme_color": "#05090f",
  "categories": ["navigation", "weather", "utilities"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "display_override": ["standalone", "minimal-ui"],
  "shortcuts": [
    {
      "name": "Alertas do Brasil",
